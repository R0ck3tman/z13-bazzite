#%PAM-1.0
# z13-bazzite: face unlock (howdy) on the Plasma lock screen.
# kscreenlocker runs this stack in the background next to the "kde" (password) stack; whichever
# succeeds first unlocks. The GZ302EA has no fingerprint reader, so pam_fprintd is replaced by
# pam_howdy. Leave /etc/pam.d/kde alone: a second pam_howdy there would fight over the IR camera.
# Enroll first with `ujust z13-howdy-setup`. Until then this fails quietly and the password works.
auth       requisite    pam_nologin.so
auth       requisite    pam_faillock.so preauth
auth       required     pam_howdy.so
account    include      password-auth
password   required     pam_deny.so
session    include      password-auth
