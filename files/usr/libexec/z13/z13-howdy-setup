#!/usr/bin/bash
# Face unlock for the Plasma lock screen (/etc/pam.d/kde-fingerprint in the image).
# Usage (as root, via ujust): z13-howdy-setup <user>
# Points howdy at the IR camera, raises the timeout to 8 s (4 s was too short), and enrolls two face
# models (a second one recorded in different light makes it much more reliable).
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "Run as root (ujust asks for your password)"; exit 1; }
user=${1:?usage: z13-howdy-setup <user>}
cfg=/etc/howdy/config.ini
ir=$(ls /dev/v4l/by-path/*usb-0:1:1.2-video-index0 2>/dev/null | head -1 || true)
if [[ -z $ir ]]; then
  echo "IR camera not found at its usual path. Candidates:"; ls -l /dev/v4l/by-path/ || true
  read -rp "Device path to use: " ir
fi
sed -i -E "s#^device_path *=.*#device_path = $ir#; s#^timeout *=.*#timeout = 8#" "$cfg"
grep -E '^(device_path|timeout) *=' "$cfg"
echo "Look at the camera. First model:"
howdy -U "$user" add
read -rp "Change the lighting or your position a bit, then press Enter for a second model..."
howdy -U "$user" add
echo "Done. Lock the screen (Meta+L) to test: face unlock starts by itself."
